# ========================================================
# RPLearn - Root .gitignore
# Melindungi file sensitif, kredensial, dan env agar tidak ter-push ke Git
# ========================================================

# 1. Environment & Secret Variables (SANGAT KRUSIAL)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.env
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# 2. Kredensial, Private Keys, & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
credentials.json
service-account*.json

# 3. Dependencies (Paket Eksternal)
node_modules/
**/node_modules/
package-lock.json.bak

# 4. Production Build Outputs & Bundles
dist/
**/dist/
build/
**/build/
.output/

# 5. Logs, Cache, & Diagnostic
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# 6. Database Dumps & Local Storage
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db
pids/
*.pid
*.seed
*.pid.lock

# 7. OS & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.user
*.ntvs*
*.njsproj
*.sln
