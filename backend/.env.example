# RPLearn Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration (Laragon)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rplearn
DB_USER=postgres
DB_PASSWORD=

# Optional: AI Provider (Gemini / OpenAI API Key)
# Jika belum diisi, AI Chatbot akan menggunakan intelligent context-aware fallback
AI_API_KEY=
